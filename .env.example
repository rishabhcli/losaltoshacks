VITE_INSFORGE_URL=https://r5em4tn7.us-west.insforge.app
VITE_INSFORGE_ANON_KEY=replace-with-your-insforge-anon-key

# Browser Use Cloud (parallel browser agents)
BROWSER_USE_API_KEY=replace-with-your-browser-use-cloud-api-key
BROWSER_USE_API_BASE_URL=https://api.browser-use.com/api/v3
MASTERBUILD_BROWSER_MODE=cloud
MASTERBUILD_BROWSER_CLOUD_MODEL=claude-sonnet-4.6
MASTERBUILD_BROWSER_CLOUD_PROXY_COUNTRY=us
MASTERBUILD_BROWSER_CLOUD_POLL_SECONDS=2
MASTERBUILD_BROWSER_CLOUD_MAX_FINDINGS=6
MASTERBUILD_BROWSER_CLOUD_TIMEOUT_SECONDS=35

# Non-demo API boundary. Use exact browser origins and image hosts; do not use
# `*` for a deployed application. Demo mode bypasses this gate for local QA.
MARKETPULSE_ALLOWED_ORIGINS=https://app.example.com
MARKETPULSE_ALLOWED_IMAGE_HOSTS=images.example.com
MARKETPULSE_API_RATE_WINDOW_MS=60000
MARKETPULSE_API_RATE_LIMIT=120
MARKETPULSE_API_PROVIDER_RATE_LIMIT=30
MARKETPULSE_API_USER_RATE_LIMIT=120
MARKETPULSE_API_USER_PROVIDER_RATE_LIMIT=30
MARKETPULSE_MAX_BODY_BYTES=1048576
